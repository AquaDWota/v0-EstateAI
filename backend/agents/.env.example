# Gemini API Configuration (for AI analysis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-latest

# uagents Network Configuration
UAGENTS_NETWORK=testnet

# Specialist timeout (seconds)
SPECIALIST_TIMEOUT=60

# Agent Public Endpoint Configuration
# Leave empty for local testing (http://127.0.0.1:8005/submit)
# For public access, use cloudflared tunnel URL + /submit
# Example: AGENT_ENDPOINT=https://abc-def-ghi.trycloudflare.com/submit
AGENT_ENDPOINT=

# Agent Seed (use secure random seed for production)
# Leave empty to use default "selector-agent" for testing
# Generate secure seed: openssl rand -base64 32
AGENT_SEED=

# Agentverse Configuration (optional - for production deployment)
AGENTVERSE_API_KEY=your_agentverse_api_key_here
